# Plain clang-format is disabled for this repository on purpose.
#
# The toolkit's C++ layout is produced by toolkit/tools/format/imtool_format.py,
# which runs a pinned clang-format with its own style file
# (toolkit/tools/format/imtool.clang-format) and then a post-pass. Running
# clang-format directly, from an editor or a hook, would give a different result,
# so this file turns it off. Format with the tool instead.
#
# The setting applies to every C and C++ file in the repository that has no
# nearer style file. It also stops include sorting (checked with clang-format
# 14, 18, 21 and 23).
DisableFormat: true
