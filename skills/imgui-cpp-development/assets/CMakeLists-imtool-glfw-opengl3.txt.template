# CMakeLists.txt — imtool toolkit starter (GLFW + OpenGL 3, Dear ImGui docking).
#
# Generated by the imgui-cpp Claude Code skill (/imgui-cpp:imgui-bootstrap).
#
# Fetches Dear ImGui v1.92.7-docking, GLFW 3.4, nlohmann/json, and the imtool
# toolkit; builds ImGui (core + GLFW + OpenGL3 backends) as a static library and
# the toolkit's Application layer (imtool_app), then links them into a `main`
# executable compiled with C++23.
#
# Offline / pinning:
#   - The imtool toolkit is fetched from the plugin repo at ${IMTOOL_GIT_TAG}
#     (default: main). Pin it to a released tag (e.g. v0.1.0) for reproducible
#     builds once one is cut.
#   - To build against a local checkout instead of the network, pass
#     -DFETCHCONTENT_SOURCE_DIR_IMTOOL=/path/to/imgui-cpp-plugin
#   - nlohmann/json prefers an installed package (find_package) before fetching.
#
# Build: mkdir build && cd build && cmake .. && cmake --build .

cmake_minimum_required(VERSION 3.21)
project(imtool_app
    LANGUAGES CXX
    VERSION 0.1.0
)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

include(FetchContent)

# Which ref of the imgui-cpp-plugin repo to pull the imtool toolkit from.
set(IMTOOL_GIT_TAG "main" CACHE STRING "git ref of imgui-cpp-plugin to fetch the imtool toolkit from")

# ---------------------------------------------------------------------------
# Dear ImGui (docking branch) + GLFW
# ---------------------------------------------------------------------------
FetchContent_Declare(imgui
    GIT_REPOSITORY https://github.com/ocornut/imgui.git
    GIT_TAG        v1.92.7-docking
    GIT_SHALLOW    TRUE)
FetchContent_MakeAvailable(imgui)

# GLFW — installed package preferred (offline / CI with libglfw3-dev), else fetched.
find_package(glfw3 CONFIG QUIET)
if(NOT TARGET glfw)
    FetchContent_Declare(glfw
        GIT_REPOSITORY https://github.com/glfw/glfw.git
        GIT_TAG        3.4
        GIT_SHALLOW    TRUE)
    set(GLFW_BUILD_DOCS     OFF CACHE BOOL "" FORCE)
    set(GLFW_BUILD_TESTS    OFF CACHE BOOL "" FORCE)
    set(GLFW_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(glfw)
endif()

find_package(OpenGL REQUIRED)

# nlohmann/json — installed package preferred (offline / CI), else fetched.
find_package(nlohmann_json CONFIG QUIET)
if(NOT nlohmann_json_FOUND)
    FetchContent_Declare(nlohmann_json
        URL https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz)
    FetchContent_MakeAvailable(nlohmann_json)
endif()

# ---------------------------------------------------------------------------
# ImGui as a static library (core + GLFW + OpenGL3 backends), exposed as the
# `imgui::imgui` target the toolkit requires. SYSTEM include dirs silence ImGui's
# old-style-cast / memset warnings (treated as third-party).
# ---------------------------------------------------------------------------
add_library(imgui STATIC
    ${imgui_SOURCE_DIR}/imgui.cpp
    ${imgui_SOURCE_DIR}/imgui_demo.cpp
    ${imgui_SOURCE_DIR}/imgui_draw.cpp
    ${imgui_SOURCE_DIR}/imgui_tables.cpp
    ${imgui_SOURCE_DIR}/imgui_widgets.cpp
    ${imgui_SOURCE_DIR}/backends/imgui_impl_glfw.cpp
    ${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp)
target_include_directories(imgui SYSTEM PUBLIC
    ${imgui_SOURCE_DIR}
    ${imgui_SOURCE_DIR}/backends)
target_link_libraries(imgui PUBLIC glfw OpenGL::GL)
add_library(imgui::imgui ALIAS imgui)

# ---------------------------------------------------------------------------
# imtool toolkit (this repo's toolkit/ subdir). IMTOOL_BUILD_APP=ON builds the
# Application layer (imtool_app) against the imgui backends above.
# ---------------------------------------------------------------------------
set(IMTOOL_BUILD_APP ON CACHE BOOL "" FORCE)
FetchContent_Declare(imtool
    GIT_REPOSITORY https://github.com/skothr/imgui-cpp-plugin.git
    GIT_TAG        ${IMTOOL_GIT_TAG}
    SOURCE_SUBDIR  toolkit)
FetchContent_MakeAvailable(imtool)

# ---------------------------------------------------------------------------
# Application executable
# ---------------------------------------------------------------------------
add_executable(main src/main.cpp)
target_link_libraries(main PRIVATE imtool::app)   # brings imtool + imgui + glfw + GL

if (CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
    target_compile_options(main PRIVATE -Wall -Wextra -Wpedantic)
elseif (MSVC)
    target_compile_options(main PRIVATE /W4)
endif()
