// main.cpp — imtool toolkit starter (GLFW + OpenGL3 + Dear ImGui docking branch).
//
// Generated by the imgui-cpp Claude Code skill (/imgui-cpp:imgui-bootstrap).
// This is NOT a bare ImGui demo window: it subclasses imtool::Application (which
// owns the GLFW window + GL context + ImGui context + frame loop) and wires up a
// live NodeGraph view and a KeyBindingManager so a fresh project builds, runs,
// and shows the toolkit immediately. Edit the node types / UI to taste.
//
// Build (CMake): see CMakeLists.txt (fetches Dear ImGui, GLFW, nlohmann/json,
// and the imtool toolkit). Then: mkdir build && cd build && cmake .. && cmake --build .

#include <cstddef>

#include <imgui.h>

#include <imtool/app/application.hpp>
#include <imtool/common/version.hpp>
#include <imtool/input/key_binding.hpp>
#include <imtool/node/node.hpp>
#include <imtool/node/node_graph.hpp>
#include <imtool/node/node_graph_display.hpp>
#include <imtool/node/node_registry.hpp>

using namespace imtool;

// --- demo node types -------------------------------------------------------
// A node declares typed ports in its constructor. Connectors are type-checked
// at connection time (a float output only connects to a float input).
// These are topology-only (no compute). For nodes that actually COMPUTE — a
// shared `ValueNode` base owning `result`, subclasses overriding only compute(),
// one upstream() helper (DRY, single-responsibility) — see the toolkit's
// calc_graph example (toolkit/fixtures/calc_nodes.hpp; under _deps/imtool-src/
// when the toolkit is fetched via FetchContent).
struct NumberNode : Node { NumberNode() : Node("Number") { addOutput<float>("value"); } };
struct AddNode    : Node { AddNode()    : Node("Add")    { addInput<float>("a"); addInput<float>("b"); addOutput<float>("sum"); } };
struct OutputNode : Node { OutputNode() : Node("Output") { addInput<float>("in"); } };

class DemoApp : public Application {
public:
    DemoApp() : Application(makeConfig()) {
        m_registry.addType<NumberNode>("Number");
        m_registry.addType<AddNode>("Add");
        m_registry.addType<OutputNode>("Output");
        m_graph.setRegistry(&m_registry);
        m_view.setGraph(&m_graph);

        // Seed a small graph: (Number, Number) -> Add -> Output.
        Node *a   = m_graph.create("Number"); if(a)   { a->setPos(Vec2f(-240.0f, -70.0f)); }
        Node *b   = m_graph.create("Number"); if(b)   { b->setPos(Vec2f(-240.0f,  70.0f)); }
        Node *add = m_graph.create("Add");    if(add) { add->setPos(Vec2f(-20.0f,   0.0f)); }
        Node *out = m_graph.create("Output"); if(out) { out->setPos(Vec2f(200.0f,   0.0f)); }
        if(a && add)   { m_graph.connect(a->output(0),   add->input(0)); }
        if(b && add)   { m_graph.connect(b->output(0),   add->input(1)); }
        if(add && out) { m_graph.connect(add->output(0), out->input(0)); }

        m_keys.registerAll({
            {"view.reset", "Reset view", "Recenter the node canvas", ImGuiMod_Ctrl | ImGuiKey_0, false, nullptr},
            {"app.quit",   "Quit",       "Close the application",     ImGuiMod_Ctrl | ImGuiKey_Q, false, nullptr},
        });
    }

protected:
    bool onInit() override {
        log() << LogLevel::Info << "imtool demo ready (v" << version_string() << ")"; log().flush();
        return true;
    }

    void onGui() override {
        if(m_keys.triggered("view.reset")) { m_view.resetView(); }
        if(m_keys.triggered("app.quit"))   { requestQuit(); }

        ImGui::SetNextWindowSize(ImVec2(960.0f, 600.0f), ImGuiCond_FirstUseEver);
        if(ImGui::Begin("imtool toolkit demo")) {
            ImGui::Text("FPS %.0f   nodes %zu   edges %zu",
                        static_cast<double>(ImGui::GetIO().Framerate),
                        m_graph.nodeCount(), m_graph.edgeCount());
            ImGui::SameLine(); if(ImGui::Button("Reset view")) { m_view.resetView(); }
            ImGui::SameLine(); if(ImGui::Button("Evaluate"))   { m_graph.evaluate(); }
            ImGui::TextDisabled("right-click: add node  |  drag port->port: connect  |  "
                                "wheel: zoom  |  drag: pan/move  |  Del: remove");
            m_view.draw();   // fills the remaining content region
        }
        ImGui::End();

        m_keys.drawEditor("Key Bindings");
    }

private:
    static AppConfig makeConfig() {
        AppConfig c;
        c.title = "imtool demo";
        c.size  = Vec2i(1280, 800);
        // c.docking = true; c.viewports = true;   // enable for a docking layout
        return c;
    }

    NodeRegistry      m_registry;
    NodeGraph         m_graph;
    NodeGraphDisplay  m_view;
    KeyBindingManager m_keys;
};

int main() {
    DemoApp app;
    return app.run();   // 0 on clean exit; non-zero == imtool::AppStatus of the failing init step
}
