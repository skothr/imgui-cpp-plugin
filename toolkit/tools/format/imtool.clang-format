# clang-format version 23.1.2  (pinned: imtool_format.py refuses any other version)
# Generated by the fitting scripts, which are added separately.  Fixed entries come from the owner's
# rules; the rest were chosen by measured churn on the hand-formatted corpus.  Use through
# imtool_format.py: clang-format alone cannot produce the full style.
Language: Cpp
Standard: c++23
ColumnLimit: 140
IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 2
IndentCaseLabels: false
NamespaceIndentation: All
AccessModifierOffset: -2
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  IndentBraces: true
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
  BeforeWhile: true
  AfterExternBlock: false
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
AllowShortEnumsOnASingleLine: true
SpaceBeforeParens: Never
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceInEmptyParentheses: false
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
Cpp11BracedListStyle: false
SpacesInContainerLiterals: true
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignEscapedNewlines: Left
AlignOperands: AlignAfterOperator
AlignTrailingComments: {Kind: Leave}
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeColon
BreakStringLiterals: false
SortIncludes: false
IncludeBlocks: Preserve
PointerAlignment: Right
DerivePointerAlignment: false
ReflowComments: false
FixNamespaceComments: false
MaxEmptyLinesToKeep: 3
SpaceBeforeCpp11BracedList: true
SpaceAfterTemplateKeyword: false
AlignConsecutiveBitFields: None
AlignConsecutiveShortCaseStatements: {Enabled: false}
SortUsingDeclarations: false
SkipMacroDefinitionBody: true
IndentCaseBlocks: false
AllowShortRecordOnASingleLine: Always
AllowShortNamespacesOnASingleLine: false
SpaceInEmptyBraces: Block
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpacesBeforeTrailingComments: 1
BitFieldColonSpacing: Both
AlignAfterOpenBracket: Align
PenaltyBreakBeforeFirstCallParameter: 19
AlignArrayOfStructures: None
BreakTemplateDeclarations: Leave
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
PackConstructorInitializers: BinPack
ConstructorInitializerIndentWidth: 2
BreakInheritanceList: BeforeColon
IndentWrappedFunctionNames: false
IndentPPDirectives: None
LambdaBodyIndentation: Signature
KeepEmptyLinesAtTheStartOfBlocks: true
EmptyLineBeforeAccessModifier: LogicalBlock
EmptyLineAfterAccessModifier: Never
CompactNamespaces: false
PenaltyReturnTypeOnItsOwnLine: 60
PenaltyBreakAssignment: 2
PenaltyExcessCharacter: 1000000
